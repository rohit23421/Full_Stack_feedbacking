generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id          Int    @id @default(autoincrement())
    clerkUserId String @unique
    email       String @unique
    name        String
    image       String
    posts       Post[]
    vote        Vote[]
    role        Role   @default(user)

    @@map("users") //mapping this model as users table
}

model Post {
    id          Int        @id @default(autoincrement())
    title       String
    description String?
    category    String
    status      PostStatus @default(under_review)
    author      User       @relation(fields: [authorId], references: [id])
    authorId    Int
    votes       Vote[]
    createdAt   DateTime   @default(now()) //whenver create new post , ahve tiestamp of now
    updatedAt   DateTime   @updatedAt

    @@map("posts")
}

enum Role {
    user
    admin
}

enum PostStatus {
    under_review
    planned
    in_progress
    completed
}

model Vote {
    id     Int  @id @default(autoincrement())
    user   User @relation(fields: [userId], references: [id])
    userId Int
    post   Post @relation(fields: [postId], references: [id])
    postId Int

    @@unique([userId, postId])
    @@map("votes")
}
